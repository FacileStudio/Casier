# Required — base64 32-byte root key protecting every project data key at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Required — internal PostgreSQL credentials (docker-compose builds DATABASE_URL from them)
POSTGRES_USER=casier
POSTGRES_PASSWORD=casier-internal-db
# POSTGRES_DB=casier

# Optional — override only outside docker-compose, which builds this itself
# DATABASE_URL=postgres://casier:casier@localhost:5432/casier?sslmode=disable

# Optional — deployment name: development, staging, production
# APP_ENV=production

# Optional — API listen port
# PORT=4000

# Optional — debug, info, warn, error
# LOG_LEVEL=info

# Optional — comma-separated CORS origins. Unset denies every cross-origin caller,
# which is what the single-container deployment wants: the client is same-origin.
# ALLOWED_ORIGINS, DOMAINS and the other legacy names are still read as fallbacks.
# "*" is refused at startup because the API sends credentials. docker-compose defaults
# it to the public host, which also seeds OIDC_SUCCESS_URL when that is left empty.
# CORS_ALLOWED_ORIGINS=https://casier.facile.studio

# Optional — public origin used to build links that leave the server, starting with
# the password reset link. Defaults to the first CORS_ALLOWED_ORIGINS entry, which is
# what docker-compose already sets, so most deployments never touch this.
# PUBLIC_URL=https://casier.facile.studio

# SMTP (optional). SMTP_HOST is the switch: without it Casier has no way to deliver a
# password reset link, so /auth/forgot-password answers 503 instead of pretending the
# mail went out. With it, SMTP_FROM and a public origin are required at startup — a
# reset flow that fails silently is how a forgotten password becomes a support ticket.
# Credentials are optional: an internal relay on a trusted network often has none, but
# a username without a password is refused. Port 587 (STARTTLS) is the default.
# SMTP_HOST=smtp.facile.studio
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Casier <no-reply@facile.studio>

# Emails allowed to call POST /admin/rotate-key, which re-encrypts every project
# data key in the instance. Empty means nobody can — the endpoint fails closed.
CASIER_ADMIN_EMAILS=

# OIDC (optional — leave empty to use email/password auth)
# OIDC_ISSUER=https://porte.facile.studio/application/o/casier/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://casier.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://casier.facile.studio
# SSO_ONLY=false

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL
# http://journal-api:4010/api on la ruche). The URL must end in /api.
# JOURNAL_URL=http://journal-api:4010/api
# JOURNAL_TOKEN=journal_casier_...
