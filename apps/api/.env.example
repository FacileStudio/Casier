DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/clef?sslmode=disable
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ENCRYPTION_KEY=

# OIDC SSO (optional — configure in Authentik as porte.facile.studio/application/o/clef/)
# OIDC_ISSUER=https://porte.facile.studio/application/o/clef/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:4000/auth/oidc/callback
# OIDC_SUCCESS_URL=http://localhost:5173
# SSO_ONLY=false

# Journal log shipping (optional)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_clef_...
